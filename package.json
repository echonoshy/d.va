{
  "name": "d-va-podcast",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first, multi-speaker podcast studio",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "model:install": "node --env-file-if-exists=.env scripts/install-model.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
