{
  "name": "d-va-podcast",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first, multi-speaker podcast studio",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
