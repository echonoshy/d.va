# 复制为 .env，可按需取消注释。npm start 会加载该文件。
# HOST=127.0.0.1
# PORT=8787
# FFMPEG_PATH=/usr/bin/ffmpeg

# 可选：用话题生成对话脚本。留空时仍可手工编辑并配音。
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# 可选：已有的 AISHELL-3 模型目录；默认由 npm run model:install 管理。
# DVA_MODEL_DIR=/absolute/path/to/vits-icefall-zh-aishell3

# 可选：使用兼容 /v1/audio/speech 的语音服务，替代本机声线。
# DVA_TTS_BASE_URL=http://127.0.0.1:8000/v1
# DVA_TTS_MODEL=tts-1
# DVA_TTS_VOICES=alloy,onyx
# DVA_TTS_API_KEY=

# 旧版模型 API，与网页使用同一端口
# DVA_ENABLE_API=1
# 模型工作进程配置
# DVA_PYTHON=/absolute/path/to/python
# DVA_DEVICE=cpu
# DVA_LANGUAGE=zh-CN
# TTS_MAX_LEN=1000
# SSML_MAX_LEN=5000
# MAX_BATCH_SIZE=8
# WEBUI_EXPERIMENTAL=1
# SPKS_INDEX=https://example.org/speakers/index.json
